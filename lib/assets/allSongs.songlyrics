  {
    "file": "Hotel California.songlyrics",
    "lastModifiedDate": 1766111501377,
    "song": {
      "title": "Hotel California",
      "artist": "Eagles",
      "user": "Shari C.",
      "dateCreated": 1615370523430,
      "lastModifiedDate": 1766111501377,
      "copyright": "1977 Asylum, written by Don Felder, Don Henley, and Glenn Frey",
