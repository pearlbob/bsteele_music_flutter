    "song": {
      "title": "Mists of Time, The",
      "artist": "John Mayall & the Bluesbreakers",
      "user": "Rob W.",
      "dateCreated": 1566308402860,
      "lastModifiedDate": 1763368383906,
      "copyright": "John Mayall",
      "key": "Db",
