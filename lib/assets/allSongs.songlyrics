  {
    "file": "Loving Her Was Easier (Than Anything I'll Ever Do Again).songlyrics",
    "lastModifiedDate": 1773078697000,
    "song": {
      "title": "Loving Her Was Easier (Than Anything I'll Ever Do Again)",
      "artist": "Kris Kristofferson",
      "user": "Jeff H.",
      "dateCreated": 1773074867000,
      "lastModifiedDate": 1773078697000,
      "copyright": "1971 Monument",
      "key": "C",
