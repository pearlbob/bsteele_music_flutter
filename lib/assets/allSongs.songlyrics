  {
    "file": "Like a Rolling Stone.songlyrics",
    "lastModifiedDate": 1763368354125,
    "song": {
      "title": "Like a Rolling Stone",
      "artist": "Bob Dylan",
      "user": "Shari C.",
      "dateCreated": 1728885104170,
      "lastModifiedDate": 1763368354125,
      "copyright": "1965 Columbia, written by Bob Dylan",
      "key": "C",
