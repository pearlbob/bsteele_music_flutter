    "lastModifiedDate": 1781676294421,
    "song": {
      "title": "Gentle On My Mind",
      "artist": "John Hartford",
      "coverArtist": "Glen Campbell",
      "user": "Shari C.",
      "dateCreated": 1742190084513,
      "lastModifiedDate": 1781676294421,
      "copyright": "1967 Capitol Records",
      "key": "Eb",
      "defaultBpm": 110,
      "timeSignature": "2/4",
      "chords": [
        "I:",
        "Eb Eb Eb Eb x2",
        "I2:",
        "Eb Eb Eb Eb",
        "V1:",
        "Eb Ebmaj7 Eb6 Eb",
        "Fm Fm Fm Fm",
        "Fm Fmmaj7 Fm7 Bb7",
        "Eb Eb Eb Eb",
        "V2:",
        "Eb Ebmaj7 Eb6 Eb",
        "Eb Eb6",
        "Fm Fm Fm Fm",
        "Fm Fmmaj7 Fm7 Bb7",
        "Fm7 Bb7",
        "V3:",
        "Eb Ebmaj7 Eb6 Eb",
        "Fm Fm Fm Fm",
        "Fm Fmmaj7 Fm7 Bb7",
        "Fm7 Bb7",
        "O:",
        "Eb Ebmaj7 Eb6 Eb x4"
      ],
      "lyrics": [
        "I:",
        "(instrumental)",
        "V1:",
        "It's knowing that your door is always open and your path is free to",
        "Walk...that",
        "Makes me tend to leave my sleeping bag rolled up and stashed behind your",
        "Couch",
        "V2:",
        "(And it's) knowing I'm not shackled by forgotten words and bonds, and the",
        "Ink stains that are dried upon",
        "Some line...that",
        "Keeps you in the backroads by the rivers of my memory, that",
        "Keeps you ever gentle on my mind",
        "I2:",
        "(instrumental)",
        "V1:",
        "(It's not) clinging to the rocks and ivy planted on their columns now that",
        "Bind me...or",
        "Something that somebody said because they thought we fit together",
        "Walking",
        "V2:",
        "(It's just) knowing that the world will not be cursing or forgiving when I",
        "Walk along some railroad track and",
        "Find...that you're",
        "Moving on the backroads by the rivers of my memory and for",
        "Hours you're just gentle on my mind",
        "I2:",
        "(instrumental)",
        "V1:",
        "(Though the) wheat fields and the clotheslines and the junkyards and the highways come",
        "Between us...and some",
        "Other woman's crying to her mother 'cause she turned and I was",
        "Gone",
        "V2:",
        "I still might run in silence tears of joy might stain my face and the",
        "Summer sun might burn me 'til I'm",
        "Blind...but",
        "Not to where I cannot see you walking on the backroads by the",
        "Rivers flowing gentle on my mind",
        "I2:",
        "(instrumental)",
        "V1:",
        "I dip my cup of soup back from a gurgling crackling cauldron in some",
        "Train yard",
        "My beard a roughening coal pile, and a dirty hat pulled low across my",
        "Face",
        "V3:",
        "Through cupped hands 'round the tin can I pretend to hold you to my breast and",
        "Find...that you're waiting from the backroads by the rivers of my memories, ever",
        "Smilin' ever gentle on my mind",
        "O:",
        "(instrumental)"
      ]
    }
  },
