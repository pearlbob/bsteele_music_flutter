    "song": {
      "title": "Whiskey in the Jar",
      "artist": "Dubliners, The",
      "user": "Shari C.",
      "dateCreated": 1733724145925,
      "lastModifiedDate": 1733724145925,
      "copyright": "1968 Major Minor, based on traditional Irish song",
      "key": "C",
