    "file": "Wreck of the Edmund Fitzgerald, The.songlyrics",
    "lastModifiedDate": 1733730107581,
    "song": {
      "title": "Wreck of the Edmund Fitzgerald, The",
      "artist": "Gordon Lightfoot",
      "user": "Shari C.",
      "dateCreated": 1733730107581,
      "lastModifiedDate": 1733730107581,
      "copyright": "1976 Reprise",
      "key": "B",
      "defaultBpm": 188,
      "timeSignature": "6/8",
      "chords": [
        "I:",
        "Bsus2 A6/B E/B Bsus2",
