    "lastModifiedDate": 1763368526112,
    "song": {
      "title": "Twelve Thirty",
      "artist": "Mamas and Papas",
      "user": "Rob W.",
      "dateCreated": 1560730375241,
      "lastModifiedDate": 1763368526112,
      "copyright": "Universal Music Publishing Group",
      "key": "C",
      "defaultBpm": 90,
      "timeSignature": "4/4",
      "chords": [
        "V:",
        "Am D G CG",
        "Am Dm G CG",
        "Am F G EbG",
